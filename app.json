{
  "expo": {
    "name": "camera-app",
    "slug": "camera-app",
    "scheme": "camera-app",
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "image": "./assets/images/splash-icon.png", "imageWidth": 200, "resizeMode": "contain", "backgroundColor": "#ffffff" }],
      ["expo-camera"]
    ],
    "ios": {
      "infoPlist": { "NSCameraUsageDescription": "This app uses the camera to take pictures." }
    },
    "android": {
      "permissions": ["CAMERA"]
    }
  }
}
